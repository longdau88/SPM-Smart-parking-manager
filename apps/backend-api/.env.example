# Application
NODE_ENV=development
PORT=8000
API_PREFIX=api/v1

# PostgreSQL Database (with PostGIS & RLS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=spm_admin
DB_PASSWORD=REDACTED_DB_PASSWORD
DB_NAME=spm_enterprise
DB_SCHEMA=public
DB_LOGGING=true

# JWT Authentication
JWT_ACCESS_SECRET=REDACTED_JWT_ACCESS_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REDACTED_JWT_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=*
